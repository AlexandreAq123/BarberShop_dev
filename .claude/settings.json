{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./apps/api/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Edit(./.env)",
      "Edit(./apps/api/.env)",
      "Edit(./apps/api/src/generated/**)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Bash(pnpm prisma migrate reset:*)"
    ],
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:int)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  }
}
