# =============================================================================
#  API — variáveis de ambiente
#  Copie para .env (nunca versionado) e rode `pnpm env:secrets` para gerar
#  os segredos locais. Em produção, os valores vão direto no PM2 (ecosystem).
# =============================================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
TRUST_PROXY=false

# Usuário da APLICAÇÃO: só SELECT/INSERT/UPDATE/DELETE.
DATABASE_URL=mysql://barber_app:SENHA_APP@127.0.0.1:3306/barber
DB_CONNECTION_LIMIT=5

# Usuário das MIGRATIONS: DDL. Usado só pelo Prisma CLI, nunca pela API.
MIGRATION_DATABASE_URL=mysql://barber_migrator:SENHA_MIGRATOR@127.0.0.1:3306/barber
# Opcional. Sem ela, o `prisma migrate dev` cria e apaga um banco temporário.
SHADOW_DATABASE_URL=

# --- Segredos (pnpm env:secrets) ---------------------------------------------
JWT_ACCESS_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_PEPPER=

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# App Secret do app Meta (valida X-Hub-Signature-256). Token de verificação do webhook.
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- CORS ----------------------------------------------------------------------
ADMIN_ORIGIN=http://localhost:5174
BOOKING_ORIGIN=http://localhost:5173

# --- Seed (somente desenvolvimento) -------------------------------------------
SEED_OWNER_EMAIL=dono@demo.local
# Vazio = gera uma senha aleatória e mostra uma única vez no terminal.
SEED_OWNER_PASSWORD=
